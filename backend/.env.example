DJANGO_SECRET_KEY=change-me-django-secret-key-12345
DEBUG=True
ALLOWED_HOSTS=*

# Database (Provide DATABASE_URL or individual DB_* settings)
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DB_NAME=sdms_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_HOST=localhost
DB_PORT=5432

# CORS & CSRF
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
# CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Security & Audit
AUDIT_CHAIN_SECRET=change-me-hmac-secret-key-12345
PRIVATE_KEY_ENCRYPTION_SALT=change-me-private-key-salt-12345

# AI / ML Analysis
LLM_API_KEY=your-llm-provider-key
LLM_PROVIDER=gemini   # or openai, anthropic, etc.
